#!/usr/bin/env bash
set -euo pipefail

thisfile=$( readlink "${BASH_SOURCE[0]}" ) || thisfile="${BASH_SOURCE[0]}"
basedir="$( cd "$( dirname "$thisfile" )/../" && pwd -P )"

mode="${1:-serial}"
if [[ $# -gt 0 ]]; then
    shift
fi

if [[ "$mode" != "serial" && "$mode" != "parallel" ]]; then
    echo "Usage: $0 [serial|parallel] [run.php options...]"
    exit 1
fi

source "${basedir}/bin/moodle-docker-env.sh"
moodle_docker_load_env "${basedir}"
export MOODLE_DOCKER_BEHAT_MODE="$mode"
export MOODLE_DOCKER_BEHAT_PARALLEL="${MOODLE_DOCKER_BEHAT_PARALLEL:-4}"

if [ -d "${MOODLE_DOCKER_WWWROOT}/public" ]; then
    MOODLE_BEHAT_CLI_ROOT="public/admin/tool/behat/cli"
else
    MOODLE_BEHAT_CLI_ROOT="admin/tool/behat/cli"
fi

up_args=(up -d --remove-orphans)
if [[ "$mode" == "parallel" ]]; then
    up_args+=(--scale "selenium-firefox=${MOODLE_DOCKER_BEHAT_PARALLEL}")
fi

"${basedir}/bin/moodle-docker-compose" "${up_args[@]}"
"${basedir}/bin/moodle-docker-wait-for-db"
"${basedir}/bin/moodle-docker-wait-for-selenium"

echo "Running ${mode} Behat tests"
"${basedir}/bin/moodle-docker-compose" exec -T -u www-data webserver php "${MOODLE_BEHAT_CLI_ROOT}/run.php" "$@"
